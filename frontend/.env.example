# ─────────────────────────────────────────────────────────────────────────────
# Aether API Studio — frontend environment
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets here: everything with VITE_ ends up in public JavaScript.
# ─────────────────────────────────────────────────────────────────────────────

VITE_APP_NAME="Aether API Studio"

# Base URL the browser uses to call the API. Keep "/api" in development:
# requests go through the Vite dev-server proxy (same origin, no CORS needed).
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api requests (dev & preview only, not bundled).
DEV_PROXY_TARGET=http://localhost:4000

# Show the seeded demo accounts on the sign-in screen. Set to false for real deployments.
VITE_SHOW_DEMO_ACCOUNTS=true
