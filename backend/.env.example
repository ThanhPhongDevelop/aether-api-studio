# ─────────────────────────────────────────────────────────────────────────────
# Aether API — environment variables
# Copy to backend/.env (or run `npm run setup`, which also generates secrets).
# Never commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Interface to bind. Leave unset to listen on all interfaces.
# HOST=127.0.0.1
APP_NAME="Aether API"
LOG_LEVEL=info

# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Number of reverse proxies in front of the API (0 = connected directly).
TRUST_PROXY=0

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite file path, relative to the backend/ folder.
DATABASE_URL="file:./data/aether.db"

# ── Security ─────────────────────────────────────────────────────────────────
# Use long random values (min. 32 chars), different from each other. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ── Rate limiting ────────────────────────────────────────────────────────────
# Whole API, per client IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# Register / login / change-password, per client IP
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
# Lock an account for LOGIN_LOCK_MINUTES after LOGIN_MAX_ATTEMPTS wrong passwords in a row
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ── API Tester engine ────────────────────────────────────────────────────────
# Allow requests to private/loopback addresses (needed to test this API locally).
# Defaults to true outside production; keep false on public deployments (SSRF protection).
# EXECUTOR_ALLOW_PRIVATE_NETWORKS=true
# Hosts that are always allowed, comma-separated (e.g. your own API's public hostname)
EXECUTOR_ALLOWED_HOSTS=
EXECUTOR_TIMEOUT_MS=30000
EXECUTOR_MAX_RESPONSE_BYTES=5242880
EXECUTOR_RATE_LIMIT_PER_MINUTE=120

# Base URL written into the "Local" environment of every new account.
# Defaults to http://localhost:${PORT}/api (local development).
# PUBLIC_API_URL=https://aether.example.com/api

# ── Production ───────────────────────────────────────────────────────────────
# Serve the built frontend (npm run build) from this server on the same origin.
SERVE_FRONTEND=false

# ── Traffic metrics (powers /api/status and the dashboard) ───────────────────
METRICS_ENABLED=true
METRICS_RETENTION_DAYS=30
